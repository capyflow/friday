{
  "name": "friday-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Friday（小五）网页前端：Vue 3 + Vite。构建产物内联为单文件 HTML，嵌入 Go 二进制。",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.palette.config.js && vite build --config vite.wizard.config.js",
    "lint": "eslint src tests *.config.js",
    "test": "vitest run",
    "check": "npm run lint && npm run test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "gsap": "^3.15.0",
    "marked": "^16.4.1",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/test-utils": "~2.4.6",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^26.1.0",
    "vite": "^7.1.10",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.7"
  }
}
