# 复制为 config.yaml 并修改
provider:
  name: openai                 # 固定 openai（vortexagent OpenAI 兼容层）
  baseURL: https://api.example.com/v1   # 占位值，换成你的服务商 OpenAI 兼容地址
  # baseURL: https://api.deepseek.com/v1            # DeepSeek 示例
  # baseURL: https://api.stepfun.com/step_plan/v1   # 阶跃星辰 StepFun 示例
  model: 请填模型名          # 占位值，填服务商给的模型名（如 deepseek-chat / step-3.7-flash）
  apiKeyEnv: FRIDAY_API_KEY    # 从该环境变量读密钥（通用命名，任意服务商可用；
                               # 未设置时兼容回退旧名 DEEPSEEK_API_KEY）。
                               # 也可以不配环境变量：打开软件在「设置」页直接填密钥
                               # （写回下方 apiKey 字段），或在此直接粘贴明文。
  # apiKey: ""                 # 直填密钥（优先于环境变量；数据目录用户私有）
  temperature: 0.7
  maxTokens: 1024
  # contextWindow: 128000      # 激活模型的上下文窗口（一般不用手填，模型库条目会投影到这里）
  # streamUsage: false        # 流式索取 token 用量统计（缺省开启）。
                              # 关掉后「运行状态」页的金额与 token 都会归零，只在个别
                              # 网关因未知字段 stream_options 报 400 时才关，并记为排障手段。
  # 模型库（可选）：配置多个模型随时切换，激活条目自动投影到上方扁平字段并热生效；
  # 「设置 → 模型服务」可在线增删改，聊天页 composer 的「模型」标签可快捷切换。
  # active: step-5-preview     # 当前激活条目的 name（须命中下方列表）
  # models:
  #   - name: step-5-preview
  #     baseURL: https://api.stepfun.com/step_plan/v1
  #     model: step-5-preview
  #     apiKey: sk-...           # 或 apiKeyEnv: STEP_API_KEY；后台保存时留空 = 保留已存密钥
  #     contextWindow: 128000    # 留空 = 按模型名查表（未知型号按 128k）
  #     inputs: [text, image]    # 留空 = 全支持；只声明 text 则聊天页禁用图片入口
  #   - name: deepseek-chat
  #     baseURL: https://api.deepseek.com/v1
  #     model: deepseek-chat
  #     apiKeyEnv: DEEPSEEK_API_KEY
  #     contextWindow: 65536

# —— 以下 audio/asr/wake/tts/vad/display 属于硬件相关配置（语音链路已归档至
#    archive/voice-mode/，字段保留以便恢复）；纯软件形态无需关心。——
audio:
  inputDevice: ""              # 麦克风设备，留空自动选择
  outputDevice: ""             # 喇叭设备，留空自动选择
  sampleRate: 16000
  channels: 1
  # silenceRMS: 150            # 静音门限：录音 RMS 低于此值视为没人说话（防 ASR 幻觉）；0 用内置默认 150

asr:
  engine: none                 # none=文本模式(开发)；sherpa-onnx=本地离线识别
  modelDir: models/asr         # sherpa-onnx 识别模型目录。全量 Paraformer 约 230MB；
                               # 1GB 内存开发板建议 archive/voice-mode/download-models.sh --small-asr 下载
                               # 小模型（约 82MB），此目录改为
                               # models/asr/sherpa-onnx-paraformer-zh-small-2024-03-09

wake:
  engine: none                 # none=不用唤醒词；sherpa-onnx=启用唤醒词
  modelDir: models/wake        # 唤醒词 KWS 模型目录
  keywords: ["小助手"]

tts:
  engine: none                 # none=文字模式(开发)；sherpa-onnx=本地语音合成
  modelDir: models/tts         # TTS 模型目录
  voice: ""                    # 说话人，留空用模型默认

vad:
  modelPath: models/vad/silero_vad.onnx   # 语音断句模型（archive/voice-mode/download-models.sh 下载）
  threshold: 0.5               # 语音概率阈值，越大越不敏感
  minSilence: 0.6              # 静音多久判定说完（秒）
  minSpeech: 0.25              # 最短语音时长（秒）
  # modelPath 留空或文件缺失时，录音退回固定时长（asr 收不到断句信号）

display:
  driver: console              # console=终端显示；后续可接 oled/st7789 等硬件屏

# 硬件输出（扬声器/屏幕/音频播放）：Friday 当前与硬件分离（纯软件个人管家），默认关闭。
# 关闭时不注册 speak_now / display_now / play_audio / play_effect 工具，
# 任务到点的提醒经钉钉/飞书等通知渠道投递（见下方 chan 段的 pushWebhook/pushChatIDs）；
# 打开即恢复本地播报/显示能力（当前为 console 实现，接 TTS/OLED/喇叭后替换实现）。
hardware:
  enabled: false

# 天气查询（get_weather 工具，Open-Meteo 免密钥接口，支持全球城市）：
# 用户没指明城市时用 defaultCity 查询；留空则 agent 会先询问用户所在城市，
# 并可用长期记忆记住，之后无需再问。
weather:
  defaultCity: ""              # 如 "上海"

# 用户自定义指令（聊天快捷功能）：聊天中输入 name（或"name 补充内容"）自动展开为
# prompt 交给 agent，网页/终端/钉钉/飞书全入口生效，重启生效。
# 更灵活的自定义能力（接外部工具/服务）走 MCP 服务器（见下，可在线配置热生效）。
# custom:
#   commands:
#     - name: 早安简报
#       description: 日期 + 天气 + 今日待办
#       prompt: |
#         请给我一份早安简报：先说今天的日期与星期，然后查默认城市的天气并提醒带伞与否，
#         最后把待办清单里未完成的事项汇报一遍。
#     - name: 晚安
#       description: 收尾问候 + 明日提醒
#       prompt: |
#         说句晚安，并简要列出明天的定时任务和待办清单，让我安心休息。

# 技能层：技能是磁盘上的 SKILL.md（沿用 vortexagent 的框架格式），比自定义指令多了
# 模型/温度覆盖与本轮工具面白名单，正文作为技能指令注入命中的那一轮对话。
# 内容与启用都在文件里，管理后台「设置 → 技能」可增删改并即时生效（不需要重启，
# 也不需要重建 agent）。同名时项目目录覆盖本机 $HOME/.vortex/skills 里的版本。
# skills:
#   enabled: true              # false = 整个技能层关闭（不读目录、不注入）
#   dir: skills                # 技能目录（相对数据目录，每个技能一个 <id>/SKILL.md）
#   autoTrigger: true          # 自动匹配总开关；单个技能仍要写 auto: true 才参与

# 人设提示词：多套可切换的"性格与语气"（内置：default 贴心管家 / playful 活泼调皮 /
# rigorous 严谨可靠 / warm 温柔陪伴 / concise 简洁高效）。人设只改变小五怎么说话，
# 能力与工具规则不受影响，且所有人设都保留人文关怀底线。
# 管理后台"设置 → 人设提示词"可在线切换/编辑/新增自定义人设，保存即热生效并写回此处。
# persona:
#   active: default            # 当前生效的人设 ID
#   presets: []                # 自定义/覆盖预设（同 ID 覆盖内置文案，新 ID 即自定义人设）
#     - id: grumpy
#       name: 暴躁老哥
#       tagline: 语气很冲但活儿漂亮
#       prompt: |
#         - 语气很冲，吐槽归吐槽，交代的事一件不落。
#         - 关心人的方式是把事办妥，不煽情。

# systemPrompt: ""            # 可选，覆盖默认系统提示词（优先级高于 persona）

# 任务持久化文件：定时任务落到本地 JSON（增删/触发即写回），重启自动恢复；
# 停机期间过期的单次任务会在启动时立即补触发一次。
taskFile: tasks.json

# 待办清单持久化：add_todo / list_todos 等工具与管理后台"待办"页共用，
# 增删改即写回，重启不丢。
todoFile: todos.json

# HTTP 服务（vortexv3）：默认开启，打开 http://localhost:8080/ 进入统一界面
#（聊天 / 待办 / 运行状态 / 自动化 / 记忆 / 设置，聊天页可弹出调用轨迹抽屉）。
# 本机开发建议保留 8080 之外的端口：用 `--port 45678` 启动（8080 常被容器占用，
# 浏览器 localhost:8080 会解析到 IPv6 上的容器；约定见 USAGE.md「本地服务」）。
# 新部署首次启动会在本机页面创建管理员账号；远程/Docker 部署应通过下面字段或环境变量预置。
admin:
  enabled: true               # 写 false 关闭后台
  host: 127.0.0.1             # 默认仅本机；Docker 通过 ADMIN_HOST=0.0.0.0 显式开放
  port: 8080
  accountFile: admin-account.json   # 管理员账号文件（bcrypt 哈希落盘）；删除后需重新初始化
  # 启动预置账号（可选，须同时提供）：设置后每次启动以它覆盖账号文件里的账号。
  # 环境变量 FRIDAY_ADMIN_USERNAME / FRIDAY_ADMIN_PASSWORD 优先于下面两个字段。
  # username: aaron
  # password: your-password-at-least-6-chars

# 钉钉通道：让小五住进你的钉钉（Stream 模式，WebSocket 接入，无需公网 IP）。
# 接入步骤：https://open-dev.dingtalk.com 创建企业内部应用 → 消息接收模式选"Stream 模式"
# → 开通"企业内部机器人"能力 → 把 AppKey/AppSecret 填到下面 → 重启服务。
# allowUserIDs 为发送者白名单（钉钉 senderId），留空 = 允许所有联系人。
# pushWebhook 可选：自定义机器人 webhook（群机器人 Webhook 接入地址），
# 用于心跳/智能任务输出主动推送；留空则钉钉侧不接收主动推送。
# chan:
#   dingtalk:
#     enabled: true
#     clientId: "dingxxxxxxxxxxxx"
#     clientSecret: "xxxxxxxxxxxxxxxx"
#     allowUserIDs: []
#     pushWebhook: ""

# 飞书通道：长连接接入（免公网 IP），能力与钉钉对齐。
# 接入步骤：https://open.feishu.cn 创建企业自建应用 → 开启机器人能力
# → 订阅 im.message.receive_v1 事件（选择长连接）→ 申请 im:message 读写权限
# → 把 App ID/App Secret 填到下面 → 重启服务。
# allowOpenIDs 为发送者白名单（open_id），留空 = 允许所有；
# pushChatIDs 为心跳/智能任务主动推送的目标会话 chat_id 列表（机器人需已在会话内）。
# chan:
#   feishu:
#     enabled: true
#     appID: "cli_xxxxxxxx"
#     appSecret: "xxxxxxxxxxxxxxxx"
#     allowOpenIDs: []
#     pushChatIDs: []

# 会话持久化：网页/终端/钉钉/飞书共用 web 主会话，智能任务使用 task 独立会话，
# 重启自动恢复，不失忆。清除上下文按会话粒度（管理后台"设置 → 会话管理"）。
sessionFile: session.json

# token 用量账本：按天累计，并按模型/来源/会话/运行分桶，供「运行状态」页
# 与预算判定使用。文件损坏时保留原文件、本次运行只走内存账本（不用空数据覆盖）。
usageFile: token-usage.json

# 聊天暂停现场（问题 + 已生成的半句 + 当时启用的技能）：刷新页面或重启服务后
# 仍可一键「继续」；文件损坏时保留原文件并放弃加载，不用空状态覆盖。
pausedFile: paused-turns.json

# 执行类工具（write_file / edit_file / exec_command）的审批机制：
# 经 vortexagent 全局权限层生效（白名单/黑名单/模式翻译成权限规则）。
# exec.mode 三选一：
#   auto    —— 白名单内命令直接执行，白名单外拒绝（映射权限层 whitelist）
#   confirm —— 白名单外命令进网页审批队列（管理后台弹卡片），批准后执行；
#              5 分钟未处理自动拒绝；可"批准并记住"（相同调用免审批）；
#              write_file/edit_file 同样需网页批准
#   off     —— 不注册 exec_command（整体禁用；write_file/edit_file 不受影响）
# allowlist 是免审批命令白名单：按 shell 语义段级校验——复合命令（; && || |）
# 拆段后每段都须命中白名单项（整条相等或词边界前缀），感知引号；
# rm -rf、mkfs、shutdown 等毁灭性命令有内置黑名单兜底，任何模式都拦截
# （含藏在命令替换里的片段，如 echo $(rm -rf /tmp/x)）。
# tools:
#   exec:
#     mode: confirm
#     allowlist:
#       - uname -a
#       - uptime
#       - vcgencmd measure_temp
#     timeout: 30            # 默认超时秒数（上限 600）

# 全局权限附加规则（对所有工具生效，含 MCP）。基础策略由 tools.exec 派生，
# 此处只做补充与例外：
#   mode  —— 全局权限模式（参照 zcode 多档权限，设置页可在线切换热生效）：
#            confirm（默认，写文件/改配置/白名单外命令逐次网页批准）
#            acceptEdits（写文件/改 MCP 配置免审批，执行命令仍审批）
#            fullAccess（全部免审批，毁灭性命令黑名单仍强制拦截）
#   mcp   —— MCP 工具是否进网页审批：allow（默认，免审批）| confirm
#   allow —— 附加放行规则，"工具名" 或 "工具名:参数模式"
#   deny  —— 附加拒绝规则，任何模式（含用户批准）下命中即拒
# permissions:
#   mode: confirm
#   mcp: allow
#   allow:
#     - mcp_muse_*
#   deny: []

# 心跳式主动任务（对标 OpenClaw HEARTBEAT.md）：agent 定期醒来读清单自主巡检，
# 输出首行 [推送]/[静默] 决定是否打扰用户；静默时段内只记轨迹不推送。
# schedule（cron）与 interval（时长）二选一，都填时 schedule 优先。
# heartbeat:
#   enabled: false
#   schedule: "0 8 * * *"    # 每天 8:00（标准 5 段 cron）
#   interval: ""             # 如 "30m"（内部转为 @every 30m）
#   quietHours: "23:00-07:00" # 静默时段（支持跨零点），留空关闭
#   file: HEARTBEAT.md       # 清单文件（管理后台"设置"页可编辑）

# 成本观测与软限额：额度是"软"的——超线停的是心跳巡检、智能任务、目标启动这类
# 主动型工作；你正在进行的对话绝不会被掐断，定时提醒（不调模型）照常送达。
# 金额需要价格表：在管理后台「设置 → 成本与预算」配 data/pricing.json（热生效）；
# 未配价的模型只统计 token、不计入金额，并在页面单列提示。
# budget 各项 0 = 该项不限；softRatio 是预警线（达到即 warn，达到额度即 over）。
# cost:
#   currency: CNY
#   pricingFile: pricing.json  # 价格表文件（后台可编辑，不进 config 避免热更链路）
#   budget:
#     dailyTokens: 2000000     # 日 token 额度（输入+输出）
#     monthlyTokens: 0
#     dailyCost: 0             # 日金额额度（需价格表命中）
#     monthlyCost: 0
#     softRatio: 0.8           # 预警阈值
#     perPlanTokens: 60000     # 单次计划（全部步骤合计）软预算
#     perGoalTokens: 120000    # 单个目标默认 token 预算（任务可逐项覆盖）
#     perGoalSteps: 12         # 单个目标默认步数上限
#   pauseProactive: true       # false = 只警示不停手
#   goals:
#     maxConcurrent: 1         # 同时运行的目标数（目标轮次长，串行更稳）

# 计划模式：聊天里选「计划」→ 小五先产出步骤清单 → 你在网页确认 → 按步执行
# （一步一次独立提问、一条独立轨迹、一份独立成本，可随时暂停/继续/重试某步）。
# planFile: plans.json  计划持久化路径（重启自动恢复；恢复时正在执行的计划降为暂停，
#                       不自动续跑——副作用不可知，需要用户点头）
planFile: plans.json
# plan:
#   enabled: true              # false 时聊天里的「计划」请求直接被拒并说明原因
#   maxIterations: 12          # 规划轮与每一步各自的工具轮数上限（框架默认仅 10）

# MCP 服务器（Model Context Protocol）：工具以 mcp_<名称>_<工具名> 前缀动态注册进
# agent。两种接入方式二选一（管理后台"设置 → MCP 服务器"可在线配置，保存即热生效）：
#   本地命令（stdio）：Friday 拉起本机子进程，崩溃自动重启；
#   远程 URL（Streamable HTTP）：连接托管 MCP 服务，headers 可带鉴权。
# mcp:
#   servers:
#     - name: filesystem                      # 方式一：本地命令
#       command: npx
#       args: ["-y", "@modelcontextprotocol/server-filesystem", "/home/user/shared"]
#       env: {}
#     - name: remote-tools                    # 方式二：远程 URL
#       url: https://mcp.example.com/mcp
#       headers: {"Authorization": "Bearer xxx"}

# 文件工具（read_file / list_files / write_file / edit_file）的访问白名单：
# agent 只能读写这些目录内的文件。相对路径基于服务运行目录。
# 默认仅允许运行目录（"."）。
# file:
#   allowDirs:
#     - .
#     - /home/user/documents

# 长期记忆：按主题分页的 wiki（偏好/习惯等），每页一个 <id>.md 文件，落盘重启不丢。
# 旧版扁平 memories.json 仍在时，首次启动自动迁入《用户档案》页（原文件保留）。
memory:
  dir: memories
  file: memories.json

# 上下文引擎：长会话不再线性膨胀。活跃上下文 = 交接摘要区 + 最近块原文 +
# 按需检索（模型可调 search_history / expand_chunk 回看已归档原文），
# 原始历史不可变归档在 archiveDir，对话超窗口用量 70% 时轮末自动归档压缩。
# 比例/块数留 0 走默认（软阈值 0.7 / 摘要区 10% / 保留最近 12 块 / 检索 5 条）。
context:
  enabled: true
  archiveDir: archive
  # 归档时抽取的候选事实自动写入记忆 wiki（source=agent，后台可改可删）
  candidateFacts: true
  # 上下文窗口 token 数：全局显式覆盖，优先级最高；未设置时用模型库激活条目的
  # contextWindow，再未设置按模型名查表（未知型号按 128k，非标准命名时建议显式配）
  # windowTokens: 65536
  # retentionDays: 0        # 归档保留天数，0 = 永久
