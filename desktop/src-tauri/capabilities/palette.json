{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "palette-remote",
  "description": "全局快捷键弹窗（加载内核 /palette 远程页）最小权限：页面 Esc 时调用窗口 hide。",
  "windows": ["palette"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "allow-auth-get-token",
    "allow-auth-set-token",
    "allow-auth-clear-token"
  ]
}
