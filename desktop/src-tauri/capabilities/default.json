{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口（本地占位页）最小权限：监听 server-ready 事件并导航到内核地址，必要时交给系统浏览器开外链。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-kernel-state",
    "allow-pick-data-dir-dialog",
    "allow-apply-data-dir",
    "allow-open-url"
  ]
}
