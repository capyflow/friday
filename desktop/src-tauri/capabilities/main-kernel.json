{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-kernel",
  "description": "主窗口内核页面仅可显式启用系统通知与首装向导的目录操作；Rust 再检查当前内核准确 origin。",
  "local": false,
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*"] },
  "permissions": [
    "allow-enable-notifications",
    "allow-notifications-enabled",
    "allow-kernel-state",
    "allow-pick-data-dir-dialog",
    "allow-apply-data-dir"
  ]
}
