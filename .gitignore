# 构建产物
/robot
/dist/

# 本地配置（含密钥环境变量名）
config.yaml

# 运行时持久化文件（任务/记忆/管理员账号）
/tasks.json
/memories.json
/admin-account.json

# 语音模型（体积大，不入库）
/models/

# IDE
.idea/
.vscode/
# 本地会话元数据
/.codegraph
/.omo/

# 运行日志（allspark logx 自动创建）
logs/
# 用户上传的图片
/uploads/

# 会话持久化（多会话历史，运行时数据）
/session.json
# 用户本地备忘（agent 演示用，个人内容不入库）
/notes.txt

# Docker 部署：数据目录与环境变量
/data/
/.env

# 本地工具目录
/.zcode/
