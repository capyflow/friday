# 构建上下文只保留源码与构建所需文件；本地运行数据/密钥一律不进镜像。
.git
.zcode
.gitignore
.dockerignore

# 本地运行数据与密钥（挂在 /data 卷里，不烤进镜像）
config.yaml
data/
.env
.env.*
!.env.example
todos.json
notifications.json
session.json
tasks.json
memories.json
admin-account.json
HEARTBEAT.md
uploads/
logs/
notes.txt

# 本地产物与非构建必需目录
robot
web/node_modules/
desktop/src-tauri/target/
desktop/src-tauri/binaries/
desktop/src-tauri/resources/
desktop/src-tauri/icons/
.mimosa/
.workbuddy/
.zcodeignore
.DS_Store
**/.DS_Store
design-system/
docs/
archive/

# Docker 自身（entrypoint.sh 在 docker/ 下，必须保留在上下文中）
Dockerfile

# 前端构建产物：由 Dockerfile 的 node 阶段生成，宿主机本地副本不进上下文
internal/admin/webdist/index.html
internal/admin/webdist/palette.html
